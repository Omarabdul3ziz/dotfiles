layout {
  cwd "/home/omar/github.com/Omarabdul3ziz/souqnazr.at/"

  default_tab_template {
    children
    pane size=1 borderless=true {
        plugin location="file:/home/omar/.config/zellij/plugins/statusbar.wasm"
    }
  }

  tab name="src" {
    pane command="nvim" {
      args "."
    } 
  }

  tab name="agent" {
    pane command="claude"
  }

  tab name="shell" {
    pane
  }

}
