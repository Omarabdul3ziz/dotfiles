layout {
  cwd "/home/omar/"

  default_tab_template {
    children
    pane size=1 borderless=true {
        plugin location="file:/home/omar/.config/zellij/plugins/statusbar.wasm"
    }
  }

  tab name="dotfiles" {
    pane stacked=true {
      pane name="src" cwd="/home/omar/github.com/Omarabdul3ziz/dotfiles/" command="nvim" {
        args "."
      }
      pane name="claude" cwd="/home/omar/github.com/Omarabdul3ziz/dotfiles/" command="claude"
    }
  }

  tab name="omarchy" {
    pane stacked=true {
      pane name="src" cwd="/home/omar/.local/share/omarchy/" command="nvim" {
        args "."
      }
      pane name="claude" cwd="/home/omar/.local/share/omarchy/" command="claude"
    }
  }

  tab name="shell" {
    pane
  }
}
