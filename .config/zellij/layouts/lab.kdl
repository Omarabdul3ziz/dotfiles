layout {
  cwd "/home/omar/github.com/Omarabdul3ziz"

  default_tab_template {
    children
    pane size=1 borderless=true {
        plugin location="file:/home/omar/.config/zellij/plugins/statusbar.wasm"
    }
  }

  tab name="dotfiles" {
    pane command="nvim" {
      args "dotfiles"
    } 
  }

  tab name="omarchy" cwd="/home/omar/.local/share/omarchy/" {
    pane command="nvim" {
      args "."
    }
  }

  tab name="agent" {
    pane command="claude"
  }

  tab name="shell" {
    pane
  }

  tab name="homelab" {
    pane command="ssh" {
      args "homelab"
    }
  }
}
