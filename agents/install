#!/usr/bin/env bash
# Builds the global agent instructions and skill links for every harness on
# this machine, from persona.md + skills/ here plus the packs listed in
# ~/.config/agents/packs (one directory per line; each may hold rules.md,
# INDEX.md and skills/<name>/). Idempotent; re-run after any edit.
set -euo pipefail
cd "$(dirname "$0")"
here=$PWD
packs_file=$HOME/.config/agents/packs

packs=()
if [ -f "$packs_file" ]; then
  while read -r p; do
    p=${p/#\~/$HOME}
    case $p in ''|'#'*) continue ;; esac
    if [ -d "$p" ]; then packs+=("$p"); else echo "skip missing pack: $p" >&2; fi
  done < "$packs_file"
fi

# One instruction file; $1 is an optional adapter appended for one harness.
build() {
  echo "<!-- generated by $here/install from persona.md and packs; edit those, then re-run -->"
  echo
  cat persona.md
  for p in "${packs[@]}"; do
    for f in rules.md INDEX.md; do
      if [ -f "$p/$f" ]; then echo; cat "$p/$f"; fi
    done
  done
  if [ -n "${1:-}" ]; then cat "$1"; fi
}

# Write generated content over a file or a symlink (never through it).
put() {
  mkdir -p "$(dirname "$1")"
  cat > "$1.tmp"
  mv -f "$1.tmp" "$1"
}

# Link $2 -> $1. A real file in the way moves to ~/.local/state/agents/aside/,
# not next to it, where a harness would still load it.
link() {
  if [ -e "$2" ] && [ ! -L "$2" ]; then
    aside=$HOME/.local/state/agents/aside/$(date +%Y%m%d-%H%M%S)${2#"$HOME"}
    mkdir -p "$(dirname "$aside")"
    mv "$2" "$aside"
    echo "moved aside: $aside"
  fi
  mkdir -p "$(dirname "$2")"
  ln -sfn "$1" "$2"
}

build | put "$HOME/.agents/AGENTS.md"
build adapters/claude.md | put "$HOME/.claude/CLAUDE.md"

# Harnesses that read their own file get a link to the shared one.
# dsh reads ~/.agents/AGENTS.md itself.
[ -d "$HOME/.pi/agent" ]        && link "$HOME/.agents/AGENTS.md" "$HOME/.pi/agent/AGENTS.md"
[ -d "$HOME/.config/opencode" ] && link "$HOME/.agents/AGENTS.md" "$HOME/.config/opencode/AGENTS.md"
[ -d "$HOME/.codex" ]           && link "$HOME/.agents/AGENTS.md" "$HOME/.codex/AGENTS.md"

# Skills: ~/.agents/skills (pi, dsh, codex, opencode) and ~/.claude/skills.
# pi also reads ~/.pi/agent/skills; a symlinked one would load them twice.
[ -L "$HOME/.agents/skills" ] && rm "$HOME/.agents/skills"
[ -L "$HOME/.pi/agent/skills" ] && rm "$HOME/.pi/agent/skills"
sources=("$here/skills" "${packs[@]/%//skills}")
for dir in "$HOME/.agents/skills" "$HOME/.claude/skills"; do
  mkdir -p "$dir"
  # Drop links we made earlier whose skill is gone, and any dangling link.
  for l in "$dir"/*; do
    [ -L "$l" ] || continue
    t=$(readlink "$l")
    for s in "${sources[@]}"; do
      case $t in "$s"/*) [ -e "$t" ] || rm "$l" ;; esac
    done
    [ -e "$l" ] || rm -f "$l"
  done
  for s in "${sources[@]}"; do
    [ -d "$s" ] || continue
    for sk in "$s"/*/; do
      sk=${sk%/}
      link "$sk" "$dir/$(basename "$sk")"
    done
  done
done

echo "agents: ${#packs[@]} pack(s), skills: $(cd "$HOME/.agents/skills" && ls | tr '\n' ' ')"
