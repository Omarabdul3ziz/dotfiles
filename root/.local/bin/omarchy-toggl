#!/usr/bin/env bash
# Toggl Track control for the Omarchy bar.
#
#   omarchy-toggl status   Waybar-style JSON for the bar (local, ~free)
#   omarchy-toggl toggle   stop if running, else resume the last entry
#   omarchy-toggl start [description]
#   omarchy-toggl stop
#   omarchy-toggl pick     fuzzy-pick a recent entry to start
#   omarchy-toggl sync     force a full refresh from the API
#
# Toggl allows only ~30 API requests/hour/user on Free/Starter/Premium, so the
# bar never calls the API directly: `status` renders from a cache and computes
# elapsed time locally, and only triggers a 1-request poll every POLL_SEC.
set -uo pipefail

API="https://api.track.toggl.com/api/v9"
ENV_FILE="${TOGGL_ENV_FILE:-$HOME/.config/omarchy/toggl.env}"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-toggl"
CACHE="$CACHE_DIR/state.json"
LOCK="$CACHE_DIR/refresh.lock"

ICON=$'\uf017'        # fa-clock-o
ICON_PROJECT=$'\uf02b'  # fa-tag

POLL_SEC=240      # ask "is a timer running?" every 4 min -> 15 req/hr (1 request each)
FULL_SEC=21600    # projects + recent entries every 6h -> ~0.5 req/hr (3 requests each)
BACKOFF_SEC=600   # pause polling this long after a 402/429

mkdir -p "$CACHE_DIR"
[[ -f "$ENV_FILE" ]] && . "$ENV_FILE"
TOKEN="${TOGGL_API_TOKEN:-}"

# Shared jq helpers (date parsing + formatting), prepended to jq programs.
JQ_LIB='
def pad2: floor | tostring | if length < 2 then "0" + . else . end;
# jq fromdateiso8601 only accepts a trailing Z; Toggl also returns +HH:MM offsets.
def parse_iso:
  (sub("\\.[0-9]+"; "")) as $t
  | if ($t | test("Z$")) then ($t | fromdateiso8601)
    else ($t | capture("^(?<base>.*)(?<sign>[+-])(?<oh>[0-9]{2}):(?<om>[0-9]{2})$")) as $m
      | if $m == null then ($t + "Z" | fromdateiso8601)
        else (($m.base + "Z") | fromdateiso8601)
             - ((if $m.sign == "+" then 1 else -1 end) * (($m.oh|tonumber)*3600 + ($m.om|tonumber)*60))
        end
    end;
def clock: (./3600|pad2) + ":" + ((.%3600)/60|pad2) + ":" + (.%60|pad2);
def human: floor as $s
  | if $s < 60 then "\($s)s"
    elif $s < 3600 then "\(($s/60)|floor)m"
    else "\(($s/3600)|floor)h \((($s%3600)/60)|floor)m" end;
'

HTTP_CODE=0
api() { # api METHOD PATH [BODY] -> body on stdout, status in $HTTP_CODE
  local method="$1" path="$2" body="${3:-}" out
  local args=(-sS --max-time 12 -w '\n%{http_code}' -u "$TOKEN:api_token" -X "$method" "$API$path")
  [[ -n "$body" ]] && args+=(-H 'Content-Type: application/json' -d "$body")
  out=$(curl "${args[@]}" 2>/dev/null)
  HTTP_CODE=${out##*$'\n'}
  printf '%s' "${out%$'\n'*}"
  case "$HTTP_CODE" in 200|201) return 0 ;; 402|429) mark_backoff "${out%$'\n'*}"; return 2 ;; *) return 1 ;; esac
}

die()    { echo "omarchy-toggl: $*" >&2; exit 1; }
notify() { command -v notify-send >/dev/null && notify-send -a Toggl "$@" >/dev/null 2>&1; }
now()    { date +%s; }
need_token() { [[ -n "$TOKEN" ]] || die "no API token. Put TOGGL_API_TOKEN=... in $ENV_FILE"; }

cget() { jq -r "$1" "$CACHE" 2>/dev/null; }          # read a field from the cache
cset() { # cset [--arg ...] '<jq filter>' : merge into the cache atomically.
  # The jq filter is the LAST argument; everything before it is passed to jq as-is.
  local args=("$@") filter="${@: -1}"
  unset 'args[${#args[@]}-1]'
  [[ -f "$CACHE" ]] || echo '{}' > "$CACHE"
  jq "${args[@]}" "$filter" "$CACHE" > "$CACHE.tmp" 2>/dev/null && mv "$CACHE.tmp" "$CACHE"
}

# Toggl's 402 body says exactly when the quota resets; trust it over a fixed guess.
mark_backoff() {
  local body="${1:-}" secs
  secs=$(grep -oE '[0-9]+ seconds' <<<"$body" | grep -oE '[0-9]+' | head -1)
  [[ "$secs" =~ ^[0-9]+$ ]] || secs=$BACKOFF_SEC
  (( secs > 7200 )) && secs=7200
  cset --arg t "$(( $(now) + secs + 5 ))" '.cooldown_until = ($t|tonumber)'
}

# Stamp an attempt BEFORE making it, so a failing refresh can never re-fire every
# second. Success overwrites these with real timestamps.
stamp_attempt() { cset --arg t "$(now)" "$1"' = ($t|tonumber)'; }
in_backoff()   { local u; u=$(cget '.cooldown_until // 0'); (( ${u:-0} > $(now) )); }

# --- refresh ---------------------------------------------------------------

# 1 request: is a timer running right now?
poll_current() {
  need_token
  local cur; cur=$(api GET /me/time_entries/current) || return $?
  [[ -n "$cur" ]] || cur=null
  cset --argjson cur "$cur" --arg t "$(now)" '
    .polled_at = ($t|tonumber)
    | .cooldown_until = 0
    | .current = (if ($cur|type) == "object" then {
        id: $cur.id, description: ($cur.description // ""),
        project_id: $cur.project_id, tags: ($cur.tags // []),
        workspace_id: $cur.workspace_id, start: $cur.start
      } else null end)'
}

# 3 requests: workspace id, projects, recent entries.
refresh_full() {
  need_token
  local me wid projects recent clients tasks
  me=$(api GET /me) || return $?
  wid=$(jq -r '.default_workspace_id // empty' <<<"$me")
  [[ -n "$wid" ]] || return 1
  projects=$(api GET "/workspaces/$wid/projects?active=true&per_page=200") || projects='[]'
  recent=$(api GET "/me/time_entries?since=$(( $(now) - 60*60*24*30 ))") || recent='[]'
  clients=$(api GET "/workspaces/$wid/clients?status=active") || clients='[]'
  # Workspace-wide, so one request covers every project's tasks.
  tasks=$(api GET "/workspaces/$wid/tasks?active=true") || tasks='{}'
  jq -e 'type' >/dev/null 2>&1 <<<"$recent" || recent='[]'
  jq -e 'type' >/dev/null 2>&1 <<<"$clients" || clients='[]'
  jq -e 'type' >/dev/null 2>&1 <<<"$tasks" || tasks='{}'

  cset --arg wid "$wid" --argjson projects "${projects:-[]}" --argjson recent "${recent:-[]}" \
       --argjson clients "${clients:-[]}" --argjson tasks "$tasks" --arg t "$(now)" '
    ($projects | if type == "object" then (.items // []) else . end) as $projs
    | def pname($id): $projs | map(select(.id == $id)) | .[0].name // null;
    .workspace_id = ($wid|tonumber)
    | .full_at = ($t|tonumber)
    | (($clients | if type == "array" then . else [] end)) as $cls
    | .clients = ($cls | map({id, name}))
    | .projects = ($projs | map(. as $p | {id, name, color, client_id: $p.client_id,
        client: (($cls | map(select(.id == $p.client_id)) | .[0].name) // null)}))
    | .tasks = (($tasks | if type == "object" then (.data // []) else (. // []) end)
        | if type == "array" then . else [] end
        | map({id, name, project_id, active: (.active // true)}) | map(select(.active)))
    | .entries = (
        ($recent | if type == "array" then . else [] end)
        | map(select((.duration // 0) > 0 and (.server_deleted_at // null) == null))
        | map({start, duration, project_id, description: (.description // "")}))
    | .recent = (
        ($recent | if type == "array" then . else [] end)
        | map(select((.duration // 0) > 0 and (.server_deleted_at // null) == null))
        | sort_by(.start) | reverse
        | reduce .[] as $x ([];
            if any(.[]; .description == ($x.description // "") and .project_id == $x.project_id)
            then . else . + [{description: ($x.description // ""), project_id: $x.project_id,
                              project: pname($x.project_id), tags: ($x.tags // [])}] end)
        | .[0:20])
    | .current = (.current | if . then . + {project: pname(.project_id)} else null end)'
}

# Background poll, at most one at a time.
poll_async() { ( flock -n 9 || exit 0; poll_current >/dev/null 2>&1 ) 9>"$LOCK" & disown 2>/dev/null || true; }

workspace_id() {
  local wid; wid=$(cget '.workspace_id // empty')
  [[ -n "$wid" ]] || { refresh_full >/dev/null 2>&1; wid=$(cget '.workspace_id // empty'); }
  [[ -n "$wid" ]] || die "could not determine workspace id"
  echo "$wid"
}

# --- commands --------------------------------------------------------------

cmd_status() {
  if [[ -z "$TOKEN" ]]; then
    jq -nc --arg f "$ENV_FILE" --arg icon "$ICON" '{text:$icon, tooltip:("Toggl: no API token\nAdd TOGGL_API_TOKEN to " + $f)}'
    return
  fi
  # First run: stamp the attempt before making it, so a hard failure (network down,
  # 5xx — neither of which trips the 402 backoff) cannot re-fire every second.
  if [[ ! -f "$CACHE" ]]; then
    stamp_attempt .full_at; stamp_attempt .polled_at
    refresh_full >/dev/null 2>&1
  fi

  # One jq pass: decide whether a poll is due AND render the pill. The bar calls
  # this every second, so it must not fan out into a pile of subprocesses.
  local out action
  out=$(jq -r --argjson now "$(now)" --argjson pollSec "$POLL_SEC" --argjson fullSec "$FULL_SEC" --arg icon "$ICON" --arg picon "$ICON_PROJECT" --arg icon "$ICON" --arg picon "$ICON_PROJECT" '
    def pad2: floor | tostring | if length < 2 then "0" + . else . end;
    # jq'"'"'s fromdateiso8601 only accepts a trailing Z; Toggl also returns +HH:MM offsets.
    def parse_iso:
      (sub("\\.[0-9]+"; "")) as $t
      | if ($t | test("Z$")) then ($t | fromdateiso8601)
        else ($t | capture("^(?<base>.*)(?<sign>[+-])(?<oh>[0-9]{2}):(?<om>[0-9]{2})$")) as $m
          | if $m == null then ($t + "Z" | fromdateiso8601)
            else (($m.base + "Z") | fromdateiso8601)
                 - ((if $m.sign == "+" then 1 else -1 end) * (($m.oh|tonumber)*3600 + ($m.om|tonumber)*60))
            end
        end;
    (($now - (.polled_at // 0))) as $sincePoll
    | (($now - (.full_at // 0))) as $sinceFull
    | (((.cooldown_until // 0) > $now)) as $cooling
    | (if $cooling then "none"
       elif $sinceFull >= $fullSec then "full"
       elif $sincePoll >= $pollSec then "poll"
       else "none" end) as $action
    | (if (.current.start // null) != null then
        (($now - (.current.start | parse_iso))
          | if . < 0 then 0 else . end) as $e
        | {text: ($icon + " " + ($e/3600|pad2) + ":" + (($e%3600)/60|pad2) + ":" + ($e%60|pad2)),
           tooltip: ((if (.current.description // "") == "" then "(no description)" else .current.description end)
                     + (if (.current.project // null) == null then "" else "\n" + $picon + " " + .current.project end)
                     + (if $cooling then "\nRate limited — retrying shortly" else "" end)
                     + "\nClick to stop · right-click to pick"),
           class: "active"}
       else
        {text: $icon,
         tooltip: ("Toggl: stopped"
                   + (if $cooling then "\nRate limited — retrying shortly" else "" end)
                   + "\nClick to resume last · right-click to pick")}
       end) as $payload
    | $action, ($payload | tojson)' "$CACHE" 2>/dev/null)

  if [[ -z "$out" ]]; then
    jq -nc --arg icon "$ICON" '{text:$icon, tooltip:"Toggl: cache unreadable — run `omarchy-toggl sync`"}'
    return
  fi
  action=${out%%$'\n'*}
  printf '%s\n' "${out#*$'\n'}"

  case "$action" in
    full) stamp_attempt .full_at; stamp_attempt .polled_at
          ( flock -n 9 || exit 0; refresh_full >/dev/null 2>&1 ) 9>"$LOCK" & disown 2>/dev/null || true ;;
    poll) stamp_attempt .polled_at; poll_async ;;
  esac
}

cmd_stop() {
  need_token
  local cur id wid
  cur=$(api GET /me/time_entries/current) || die "API error (HTTP $HTTP_CODE)"
  if [[ "$(jq -r 'type' <<<"$cur" 2>/dev/null)" != "object" ]]; then
    cset '.current = null'; return 0
  fi
  id=$(jq -r '.id' <<<"$cur"); wid=$(jq -r '.workspace_id' <<<"$cur")
  if api PATCH "/workspaces/$wid/time_entries/$id/stop" >/dev/null; then
    cset '.current = null'
  else
    die "could not stop timer (HTTP $HTTP_CODE)"
  fi
}

start_entry() { # DESCRIPTION [PROJECT_ID] [TAGS_JSON] [TASK_ID]
  need_token
  local desc="${1:-}" pid="${2:-null}" tags="${3:-[]}" tid="${4:-null}" wid body res
  [[ "$pid" == "null" || "$pid" =~ ^[0-9]+$ ]] || pid=null
  [[ "$tid" == "null" || "$tid" =~ ^[0-9]+$ ]] || tid=null
  wid=$(workspace_id)
  body=$(jq -nc --arg d "$desc" --arg wid "$wid" --argjson pid "$pid" --argjson tags "$tags" \
    --argjson tid "$tid" --arg start "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{created_with:"omarchy", description:$d, workspace_id:($wid|tonumber),
      project_id:$pid, task_id:$tid, tags:$tags, duration:-1, start:$start}
     | with_entries(select(.value != null))
     | . + {project_id:$pid, task_id:$tid} | with_entries(select(.value != null))')
  res=$(api POST "/workspaces/$wid/time_entries" "$body") || die "could not start timer (HTTP $HTTP_CODE)"
  cset --argjson r "$res" '.current = {id: $r.id, description: ($r.description // ""),
    project_id: $r.project_id, project: ((.projects // []) | map(select(.id == $r.project_id)) | .[0].name // null),
    tags: ($r.tags // []), workspace_id: $r.workspace_id, start: $r.start} | .polled_at = 0'
}

cmd_start() {
  local pid=null tid=null
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -p|--project) pid="${2:-null}"; shift 2 ;;
      -t|--task)    tid="${2:-null}"; shift 2 ;;
      --) shift; break ;;
      *) break ;;
    esac
  done
  if [[ "$pid" != "null" || "$tid" != "null" ]]; then start_entry "$*" "$pid" "[]" "$tid"; return; fi
  if [[ $# -gt 0 && -n "$*" ]]; then start_entry "$*"; return; fi
  [[ "$(cget '.recent | length')" =~ ^[0-9]+$ ]] || refresh_full >/dev/null 2>&1
  local last; last=$(cget '.recent[0] // empty')
  [[ -n "$last" ]] || { start_entry ""; return; }
  start_entry "$(jq -r '.description' <<<"$last")" \
              "$(jq -r '.project_id // "null"' <<<"$last")" \
              "$(jq -c '.tags // []' <<<"$last")"
}

cmd_toggle() {
  need_token
  # Trust the cache when it was polled recently; otherwise confirm with the API.
  local polled; polled=$(cget '.polled_at // 0')
  if (( $(now) - ${polled:-0} > POLL_SEC )); then poll_current >/dev/null 2>&1; fi
  if [[ "$(cget 'if .current then 1 else 0 end')" == "1" ]]; then cmd_stop; else cmd_start; fi
}

cmd_pick() {
  need_token
  local menu list choice idx e
  for m in walker fuzzel wofi rofi; do command -v "$m" >/dev/null && { menu="$m"; break; }; done
  [[ -n "${menu:-}" ]] || die "no launcher found (walker/fuzzel/wofi/rofi)"
  [[ "$(cget '.recent | length // 0')" -gt 0 ]] 2>/dev/null || refresh_full >/dev/null 2>&1

  list=$(cget '.recent | to_entries[] | "\(.key)\t\(if .value.description == "" then "(no description)" else .value.description end)\(if .value.project then "  ·  " + .value.project else "" end)"')
  [[ -n "$list" ]] || die "no recent entries to pick from"

  case "$menu" in
    walker) choice=$(cut -f2- <<<"$list" | walker --dmenu -p "Toggl") ;;
    fuzzel) choice=$(cut -f2- <<<"$list" | fuzzel --dmenu -p "Toggl: ") ;;
    wofi)   choice=$(cut -f2- <<<"$list" | wofi --dmenu -p "Toggl") ;;
    rofi)   choice=$(cut -f2- <<<"$list" | rofi -dmenu -p "Toggl") ;;
  esac
  [[ -n "${choice:-}" ]] || exit 0
  idx=$(awk -F'\t' -v c="$choice" '$2==c {print $1; exit}' <<<"$list")
  [[ -n "$idx" ]] || { start_entry "$choice"; return; }   # typed a new description
  e=$(cget ".recent[$idx]")
  start_entry "$(jq -r 'if .description == "" then "" else .description end' <<<"$e")" \
              "$(jq -r '.project_id // "null"' <<<"$e")" \
              "$(jq -c '.tags // []' <<<"$e")"
}

# Decide whether an API refresh is due and spawn it. Shared by `status` (the bar
# pill) and `data` (the panel) so either surface keeps the cache warm on its own.
maybe_poll() {
  in_backoff && return 0
  local n polled full
  n=$(now); polled=$(cget '.polled_at // 0'); full=$(cget '.full_at // 0')
  if (( n - ${full:-0} >= FULL_SEC )); then
    stamp_attempt .full_at; stamp_attempt .polled_at
    ( flock -n 9 || exit 0; refresh_full >/dev/null 2>&1 ) 9>"$LOCK" & disown 2>/dev/null || true
  elif (( n - ${polled:-0} >= POLL_SEC )); then
    stamp_attempt .polled_at
    poll_async
  fi
}

# Rich panel payload. Pure local computation over the cache -- costs no API calls.
cmd_data() {
  if [[ -z "$TOKEN" ]]; then
    jq -nc --arg f "$ENV_FILE" '{ok:false, error:("No API token. Add TOGGL_API_TOKEN to " + $f)}'
    return
  fi
  if [[ ! -f "$CACHE" ]]; then refresh_full >/dev/null 2>&1; fi
  if [[ ! -f "$CACHE" ]]; then jq -nc '{ok:false, error:"No cached data yet."}'; return; fi
  maybe_poll

  local n dow wstart_date days
  n=$(now); dow=$(date +%u)
  wstart_date=$(date -d "today - $((dow-1)) days" +%Y-%m-%d)
  # Build day buckets in LOCAL time (DST-safe: each boundary computed by date(1)).
  days=$(for i in 0 1 2 3 4 5 6; do
    jq -nc --arg l "$(date -d "$wstart_date + $i days" +%a)" \
           --argjson s "$(date -d "$wstart_date + $i days 00:00:00" +%s)" \
           --argjson e "$(date -d "$wstart_date + $((i+1)) days 00:00:00" +%s)" \
           '{label:$l, start:$s, end:$e}'
  done | jq -sc .)

  jq -c "$JQ_LIB"'
    . as $c
    | ($c.projects // []) as $P
    | def pname($id): ($P | map(select(.id == $id)) | .[0].name) // null;
      def pcolor($id): ($P | map(select(.id == $id)) | .[0].color) // null;
      ($c.entries // [] | map(. + {ts: (.start | parse_iso)})) as $E
    | $c.current as $cur
    | (if ($cur.start // null) != null
       then (($now - ($cur.start | parse_iso)) | if . < 0 then 0 else . end) else 0 end) as $elapsed
    | ($days[0].start) as $wstart
    | ($days | map(select(.start <= $now)) | last) as $today
    # completed seconds today + this week
    | ($E | map(select(.ts >= $today.start and .ts < $today.end)) | map(.duration) | add // 0) as $todayDone
    | ($E | map(select(.ts >= $wstart)) | map(.duration) | add // 0) as $weekDone
    | (if $cur and ($cur.start | parse_iso) >= $today.start then $elapsed else 0 end) as $todayRun
    | (if $cur and ($cur.start | parse_iso) >= $wstart then $elapsed else 0 end) as $weekRun
    # per-project totals for today
    | (($E | map(select(.ts >= $today.start and .ts < $today.end)))
       + (if $cur and ($cur.start | parse_iso) >= $today.start
          then [{project_id: $cur.project_id, duration: $elapsed}] else [] end)) as $todayEntries
    | ($todayEntries | group_by(.project_id) | map({
        name: (pname(.[0].project_id) // "No project"),
        color: (pcolor(.[0].project_id) // "#7f8c8d"),
        seconds: (map(.duration) | add)
      }) | sort_by(-.seconds)) as $byProject
    | {
        ok: true,
        running: ($cur != null),
        cooldown: (((.cooldown_until // 0) - $now) | if . < 0 then 0 else . end),
        stale: (($now - (.polled_at // 0)) > 900),
        current: (if $cur then {
            description: ($cur.description // ""),
            project: pname($cur.project_id), color: pcolor($cur.project_id),
            elapsed: $elapsed, elapsed_clock: ($elapsed | clock), start: $cur.start
          } else null end),
        today: { total: ($todayDone + $todayRun), label: (($todayDone + $todayRun) | human),
                 by_project: $byProject },
        week:  { total: ($weekDone + $weekRun), label: (($weekDone + $weekRun) | human),
                 by_day: ($days | map(. as $d
                   | (($E | map(select(.ts >= $d.start and .ts < $d.end)) | map(.duration) | add // 0)
                      + (if $cur and ($cur.start|parse_iso) >= $d.start and ($cur.start|parse_iso) < $d.end
                         then $elapsed else 0 end)) as $sec
                   | {label: $d.label, seconds: $sec, today: ($d.start == $today.start)})) },
        projects: ((.projects // []) | map({
            id, name, color, client,
            label: (if .client then (.client + " / " + .name) else .name end)
          }) | sort_by(.label)),
        tasks: ((.tasks // []) | map(. as $t | {
            id, name, project_id: $t.project_id,
            project: (pname($t.project_id)),
            label: ((pname($t.project_id) // "No project") + " / " + .name)
          }) | sort_by(.label)),
        recent: ((.recent // []) | map({
            description: (.description // ""),
            project: (.project // pname(.project_id)), color: pcolor(.project_id),
            project_id: .project_id, tags: (.tags // [])
          }))
      }' --argjson now "$n" --argjson days "$days" "$CACHE" 2>/dev/null \
    || jq -nc '{ok:false, error:"Cache unreadable. Run: omarchy-toggl sync"}'
}

# Start recent[N] again. Used by the panel's clickable rows.
cmd_resume() {
  need_token
  local idx="${1:-}" e
  [[ "$idx" =~ ^[0-9]+$ ]] || die "resume needs a numeric index"
  e=$(cget ".recent[$idx] // empty")
  [[ -n "$e" ]] || die "no recent entry at index $idx"
  start_entry "$(jq -r '.description' <<<"$e")" \
              "$(jq -r '.project_id // "null"' <<<"$e")" \
              "$(jq -c '.tags // []' <<<"$e")"
}

case "${1:-status}" in
  status) cmd_status ;;
  data)   cmd_data ;;
  resume) shift; cmd_resume "$@" ;;
  toggle) cmd_toggle ;;
  start)  shift; cmd_start "$@" ;;
  stop)   cmd_stop ;;
  pick)   cmd_pick ;;
  sync)   refresh_full && echo ok || die "sync failed (HTTP $HTTP_CODE)" ;;
  *)      die "unknown command: ${1:-}" ;;
esac
