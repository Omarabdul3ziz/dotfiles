{
  "$schema": "https://www.schemastore.org/claude-code-keybindings.json",
  "bindings": [
    {
      "context": "Global",
      "bindings": {
        "ctrl+shift+r": "app:redraw"
      }
    },
    {
      "context": "Chat",
      "bindings": {
        "ctrl+shift+k": "chat:clearScreen",
        "ctrl+shift+x": "chat:killAgents",
        "ctrl+shift+g": "command:commit"
      }
    }
  ]
}
