[user]
	name = Omar Abdulaziz
	email = omarabdul3ziz@gmail.com

[core]
	excludesFile = /home/omar/.gitignore
	editor = vim
	compression = 0
	pager = delta

[init]
	defaultBranch = main

[diff]
    tool = meld
[difftool]
    prompt = false
[difftool "meld"]
    cmd = meld "$LOCAL" "$REMOTE"

[merge]
    tool = meld
[mergetool "meld"]
    cmd = meld "$LOCAL" "$BASE" "$REMOTE" --output "$MERGED"
[push]
	autoSetupRemote = true
[credential]
	helper = /usr/share/doc/git/contrib/credential/libsecret/git-credential-libsecret
[pull]
	rebase = false
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	hyperlinks = true
[alias]
	ds = diff --stat
	dsc = diff --cached --stat
